# Local smoke tests do not need an API key:
#   python -m sspm run --strategy sspm --generator heuristic

# OpenRouter backend:
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Pick any model ID available on OpenRouter, e.g.
# openai/gpt-4o-mini, google/gemini-2.5-flash, deepseek/deepseek-v4-flash
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_APP_TITLE=AlphaMemo_Alpha_Mining
# Optional, useful for OpenRouter attribution:
# OPENROUTER_HTTP_REFERER=https://your-project-homepage.example

# Generic OpenAI-compatible backend:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
